  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.88, g: 0.84, b: 0.74, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: f6537b63f0d2cf0478030d67a57bb107, type: 3}
    m_FontSize: 21
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1.12
  m_Text: "FUENTES Y LICENCIAS\r\n\r\nTorre del Eclipse \u2014 I\xF1aki Bertran\r\n\r\n-
    Retro Fantasy Kit, por Kenney \u2014 kenney.nl: https://kenney.nl/assets/retro-fantasy-kit
    \u2014 CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/.\r\n- RPG
    Character Pack \u2014 Wizard, por Quaternius \u2014 quaternius.com: https://quaternius.com/packs/rpgcharacters.html
    \u2014 CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/.\r\n- RPG
    Character Pack \u2014 Cleric, por Quaternius \u2014 quaternius.com: https://quaternius.com/packs/rpgcharacters.html
    \u2014 CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/. Modelo, bast\xF3n,
    texturas y animaciones del enemigo de apoyo.\r\n- RPG Character Pack \u2014 Warrior,
    por Quaternius \u2014 Fuente original: https://quaternius.com/packs/rpgcharacters.html
    \u2014 CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/. Base del
    Custodio del Eclipse, con geometr\xEDa, materiales y animaciones adaptados en
    Blender.\r\n- LowPoly Animated Knight, por Quaternius \u2014 Fuente original:
    https://quaternius.itch.io/lowpoly-animated-knight \u2014 CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/.
    Modelo, espada y animaciones originales del guerrero.\r\n- Impact Sounds, por
    Kenney \u2014 Fuente original: https://kenney.nl/assets/impact-sounds \u2014
    CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/.\r\n- 20 Sword Sound
    Effects (Attacks and Clashes), por StarNinjas \u2014 Fuente original: https://opengameart.org/content/20-sword-sound-effects-attacks-and-clashes
    \u2014 CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/.\r\n- PSX
    Style Modular Low Poly Dungeon \u2014 Free Edition, por BlenderVoyage \u2014
    Fuente original: https://blendervoyage.itch.io/psx-style-modular-low-poly-dungeon
    \u2014 CC BY 4.0: https://creativecommons.org/licenses/by/4.0/. Integraci\xF3n
    en Unity con reorganizaci\xF3n de carpetas y ajustes de materiales/importaci\xF3n.\r\n-
    Blackmoor Colossus / Colossal Boss Battle Theme, por Matthew Pablo \u2014 Fuente
    original: https://opengameart.org/content/colossal-boss-battle-theme, compositor:
    https://www.matthewpablo.com/ \u2014 CC BY 3.0: https://creativecommons.org/licenses/by/3.0/.
    Conversi\xF3n de formato, ajuste de mezcla y transici\xF3n adaptativa entre los
    loops con y sin coros.\r\n- 100 CC0 metal and wood SFX y 80 CC0 RPG SFX, por
    rubberduck \u2014 Metal y madera: https://opengameart.org/content/100-cc0-metal-and-wood-sfx,
    RPG: https://opengameart.org/content/80-cc0-rpg-sfx \u2014 CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/.
    Selecci\xF3n, capas, cambios de velocidad/tono, niveles y fades para los efectos
    del jefe.\r\n- Large Wings Flap, por AntumDeluge, a partir de dave.des \u2014
    Fuente original: https://opengameart.org/content/large-wings-flap, base: https://freesound.org/s/127197/
    \u2014 CC0 1.0: https://creativecommons.org/publicdomain/zero/1.0/. Conversi\xF3n
    y procesamiento para aleteos y transformaci\xF3n.\r\n\r\nCrimson Text \u2014
    The Crimson Text Project Authors. SIL Open Font License 1.1.\r\nFuente: https://github.com/google/fonts/tree/main/ofl/crimsontext\r\nLicencia
    incluida junto al archivo de la fuente.\r\n\r\nIlustraciones e iconos de interfaz:
    recursos generados para Torre del Eclipse.\r\n\r\nLas marcas y juegos tomados
    como referencia no aportan modelos, grabaciones ni texturas a esta entrega.\r\n\r\nAudio
    de interfaz: dos efectos breves de s\xEDntesis (selecci\xF3n y confirmaci\xF3n),
    sin grabaciones de terceros.\r\n"
